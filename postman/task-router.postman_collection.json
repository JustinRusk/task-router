              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a page of interactions', () => {",
                  "    pm.expect(body.items).to.be.an('array');",
                  "    pm.expect(body.page).to.eql(0);",
                  "    pm.expect(body.size).to.eql(50);",
                  "    pm.expect(body.items.length).to.be.at.most(50);",
                  "    pm.expect(body.totalItems).to.be.at.least(body.items.length);",
                  "});",
                  "pm.test('Newest first', () => {",
                  "    const times = body.items.map(i => Date.parse(i.createdAt));",
                  "    for (let n = 1; n < times.length; n++) {",
                  "        pm.expect(times[n - 1]).to.be.at.least(times[n]);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
